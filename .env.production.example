# Production template: copy values into the host's environment or private .env.
# Keep PHP 8.5 with DOM, Fileinfo, OpenSSL and the selected PDO driver available.
# Set a unique APP_KEY once for this environment; preserve it across releases.
APP_NAME="Pejabat Daerah Ranau"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://replace-with-your-domain.example
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
CACHE_PREFIX=pdr_production_
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Configure real delivery before testing CMS sign-in. Do not use log/array mail.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

CALENDAR_HOLIDAY_API_ENABLED=true
# Leave empty to use the server's trusted CA store; never copy a Windows path.
CALENDAR_HOLIDAY_CA_BUNDLE=

# Web root: public/. Persist public/uploads and storage across releases.
# Writable: storage, bootstrap/cache and public/uploads (no blanket 777).
# Scheduler: run php artisan schedule:run every minute.
# Apply database migrations only after taking a backup and reviewing changes.
# Restore CMS content and uploads separately; do not import pdr.sql blindly.
# After configuring the environment: php artisan optimize
# Run php artisan deploy:check on the target before opening public traffic.
